# Copy to .env (docker compose reads it) or export in your shell.
# LM Studio: Developer tab -> Start Server. Bionic, Ollama (http://localhost:11434/v1) and any
# OpenAI-compatible gateway work too.
DARIJA_RAG_LLM_URL=http://localhost:1234/v1
# Empty = first chat model the server lists.
DARIJA_RAG_LLM_MODEL=
DARIJA_RAG_LLM_KEY=
# Optional: a different model to grade answers in eval-answers.
DARIJA_RAG_JUDGE_MODEL=
DARIJA_RAG_RETRIEVER=dense-m3+rewrite+rerank
# Device for embedding/reranking models: cpu (default; best when the LLM shares the GPU), mps, cuda.
DARIJA_RAG_DEVICE=mps
